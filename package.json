{
  "name": "simple-sanity-monorepo",
  "private": true,
  "description": "Simple sanity monorepo",
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "nx run-many --target=dev --all --parallel",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "nx run-many --target=build --all",
    "typegen": "nx run sanity-simple-monorepo:typegen",
    "graph": "nx graph"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@nx/js": "latest",
    "@nx/next": "latest",
    "nx": "latest"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
