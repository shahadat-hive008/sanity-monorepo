    "@sanity/vision": "^5.21.0",
    "lodash": "^4.18.1",
    "pluralize": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "sanity": "^5.21.0",
    "styled-components": "^6.1.18",
    "@repo/sanity-types": "workspace:*"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/lodash": "^4.17.24",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
