{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typeCheckTargetName": "typecheck",
        "buildTargetName": "build"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "typegen": {
      "dependsOn": [
        "schema:extract"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/packages/sanity-types/src/sanity.types.ts"
      ]
    },
    "schema:extract": {
      "cache": true,
      "outputs": [
        "{projectRoot}/schemas/schema.json"
      ]
    },
    "dev": {
      "continuous": true,
      "cache": false
    },
    "lint": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts"
    ]
  },
  "analytics": true
}